# coverage.py configuration
# paths are relative to the uniticket/ directory, where tests are run from:
#   cd uniticket && COVERAGE_RCFILE=../.coveragerc coverage run ./manage.py test --settings tests.settings
[run]
source =
    accounts
    api_rest
    app_io
    organizational_area
    uni_ticket
    uni_ticket_bootstrap_italia_template
    uni_ticket_project
omit =
    */migrations/*
    */tests/*
    */tests.py
    */settings.py
    */settingslocal.py
    */settingslocal.py.example
    uni_ticket_project/asgi.py
    uni_ticket_project/wsgi.py
    uni_ticket_project/routing.py
    # dead code: not imported/referenced anywhere
    uni_ticket/admin_inlines.py
    uni_ticket/context_processors.py

[report]
show_missing = True
skip_covered = True
exclude_also =
    if __name__ == .__main__.:
    raise NotImplementedError
